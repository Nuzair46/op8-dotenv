<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#EEEEEE</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">#080808</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launcher_icon</item>
    </style>
    <string name="wallpaper_description">A monochrome neural wallpaper, adapted from the CustomTV background for a portrait display.</string>
</resources>
